# INSPECTRA client - environment template
#
# Leave VITE_API_URL unset in development. Vite proxies /api to
# http://localhost:5000 (see server.proxy in vite.config.ts), so the default
# "/api/v1" is same-origin and cookies just work.
#
# Set it in production, where there is no proxy and the API lives elsewhere.
# VITE_API_URL=https://api.inspectraweb.com/api/v1
